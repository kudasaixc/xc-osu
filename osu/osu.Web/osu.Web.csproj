<Project Sdk="Microsoft.NET.Sdk.WebAssembly">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>xc-osu</AssemblyName>
    <RootNamespace>osu.Web</RootNamespace>
    <Nullable>enable</Nullable>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
    <WasmEnableThreads>true</WasmEnableThreads>
    <WasmBuildNative>true</WasmBuildNative>
    <InvariantGlobalization>false</InvariantGlobalization>
    <EmccExtraLDFlags>-sMAX_WEBGL_VERSION=2 -sMIN_WEBGL_VERSION=2 -sFULL_ES3=1 -lidbfs.js</EmccExtraLDFlags>
    <EmccMaximumHeapSize>2147483648</EmccMaximumHeapSize>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\osu.Game\osu.Game.csproj" />
    <ProjectReference Include="..\osu.Game.Rulesets.Osu\osu.Game.Rulesets.Osu.csproj" />
  </ItemGroup>
  <ItemGroup>
    <NativeFileReference Include="Native/xcweb.c" />
    <NativeFileReference Include="Native/e_sqlite3.c" />
    <NativeFileReference Include="Native/libveldrid-spirv.a" />
    <NativeFileReference Include="Native/bass.a" />
    <NativeFileReference Include="Native/bass_fx.c" />
    <NativeFileReference Include="Native/bassmix.c" />
    <NativeFileReference Include="Native/basswasapi.c" />
    <NativeFileReference Include="Native/realm-wrappers.a" />
    <!-- xc-osu!: stb_image (StbiSharp module "stbi") — native image decoding instead of managed ImageSharp. native/stbi/build.sh -->
    <NativeFileReference Include="Native/stbi.a" />
    <EmccExportedRuntimeMethod Include="FS" />
    <EmccExportedRuntimeMethod Include="IDBFS" />
  </ItemGroup>
  <Target Name="XcRemoveSingleThreadedSqlite" BeforeTargets="PrepareForBuild;_BrowserWasmLinkDotNet">
    <ItemGroup>
      <NativeFileReference Remove="@(NativeFileReference)" Condition="'%(Extension)' == '.a' and $([System.String]::Copy('%(FullPath)').Contains('e_sqlite3'))" />
    </ItemGroup>
  </Target>
  <PropertyGroup>
    <!-- lets Native/xcweb.c override broken runtime natives (see SystemNative_TryGetUInt32OSThreadId) -->
    <EmccExtraLDFlags>$(EmccExtraLDFlags) -Wl,--wrap=SystemNative_TryGetUInt32OSThreadId</EmccExtraLDFlags>
  </PropertyGroup>
  <!-- wasm C ABI fix for struct-by-value args in realm's native->managed callbacks (see tools/fix-pinvoke-structs.py) -->
  <Target Name="XcFixPInvokeStructArgs" AfterTargets="_GenerateManagedToNative" Condition="Exists('$(_WasmPInvokeTablePath)')">
    <Exec Command="python3 &quot;$(MSBuildThisFileDirectory)../../tools/fix-pinvoke-structs.py&quot; &quot;$(_WasmPInvokeTablePath)&quot;" />
  </Target>
  <ItemGroup>
    <!-- xc-osu! branding textures, looked up before osu!.Game.Resources -->
    <EmbeddedResource Remove="Resources\**\*.png" />
    <EmbeddedResource Include="Resources\**\*.png" LogicalName="xc-osu.Resources.$([System.String]::Copy(%(RecursiveDir)).Replace('/','.').Replace('\','.'))%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- xc-osu!: mixed AOT (dotnet publish -p:XcAot=true). Hot assemblies are compiled to wasm with LLVM, the rest stays interpreted. -->
  <PropertyGroup Condition="'$(XcAot)' == 'true'">
    <RunAOTCompilation>true</RunAOTCompilation>
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>partial</TrimMode>
    <DisableParallelAot Condition="'$(DisableParallelAot)' == ''">true</DisableParallelAot>
    <!-- separate intermediates: AOT strips IL from assemblies, which must never leak into interpreter builds -->
    <IntermediateOutputPath>obj/aot/</IntermediateOutputPath>
    <OutputPath>bin/aot/</OutputPath>
    <!-- no DWARF in the AOT objects: it is stripped from the final wasm anyway, and generating it slows every compile
         step down and multiplies the memory the link + wasm-opt need. tools/aotpub.sh XC_SYMBOLS=1 turns it back on. -->
    <WasmNativeDebugSymbols Condition="'$(WasmNativeDebugSymbols)' == ''">false</WasmNativeDebugSymbols>
  </PropertyGroup>
  <ItemGroup Condition="'$(XcAot)' == 'true'">
    <TrimmableAssembly Include="osuTK" />
    <TrimmerRootDescriptor Include="XcTrim.osuTK.xml" />
  </ItemGroup>
  <Target Name="XcSelectAotAssemblies" BeforeTargets="_WasmAotCompileApp" Condition="'$(XcAot)' == 'true'">
    <PropertyGroup>
      <_XcAotKeep>;System.Private.CoreLib;System.Collections;System.Collections.Concurrent;System.Linq;System.Memory;System.Runtime.Intrinsics;System.Numerics.Vectors;osu.Framework;osuTK;osu.Game;osu.Game.Rulesets.Osu;Realm;$(XcAotExtra);</_XcAotKeep>
    </PropertyGroup>
    <ItemGroup>
      <_AOT_InternalForceInterpretAssemblies Include="@(_WasmAssembliesInternal)" Condition="!$(_XcAotKeep.Contains(';%(Filename);'))" />
    </ItemGroup>
    <Message Importance="High" Text="xc-osu! AOT: interpreting @(_AOT_InternalForceInterpretAssemblies->Count()) assemblies" />
  </Target>
</Project>
